diff --git a/src/display_selection.h b/src/display_selection.h
new file mode 100644
index 00000000..0ba57e5a
--- /dev/null
+++ b/src/display_selection.h
@@ -0,0 +1,87 @@
+/**
+ * @file src/display_selection.h
+ * @brief Thread-safe display identity selection shared by management and capture.
+ */
+#pragma once
+#include <algorithm>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace video {
+  /** @brief Observable selection intent and the display actually opened by capture. */
+  struct DisplaySelectionSnapshot {
+    std::optional<std::string> preferred;  ///< Last valid user choice, retained while idle.
+    std::optional<std::string> active;  ///< Display opened by the running capture loop.
+    std::string error;  ///< Last topology-related selection failure.
+  };
+
+  /** @brief Resolve display choices by identity, never by a stale UI list position. */
+  class DisplaySelection {
+  public:
+    /**
+     * @brief Accept a choice only if that identity is currently available.
+     * @param id Requested display identity.
+     * @param available Fresh capture display identities.
+     * @return Whether the choice was accepted; rejection leaves state untouched.
+     */
+    bool request(const std::string &id, const std::vector<std::string> &available) {
+      if (id.empty() || id.size() > 256 || std::find(available.begin(), available.end(), id) == available.end()) { return false; }
+      std::lock_guard lock {mutex_};
+      state_.preferred = id;
+      state_.error.clear();
+      return true;
+    }
+
+    /**
+     * @brief Resolve the pending preference against the capture thread's fresh enumeration.
+     * @param available Fresh identities in capture order.
+     * @param fallback Existing capture selection after upstream reenumeration.
+     * @return Current index of the requested identity, a safe fallback, or -1 if no display exists.
+     */
+    int choose(const std::vector<std::string> &available, int fallback) {
+      std::lock_guard lock {mutex_};
+      if (available.empty()) { return -1; }
+      if (state_.preferred) {
+        const auto found = std::find(available.begin(), available.end(), *state_.preferred);
+        if (found != available.end()) { return static_cast<int>(found - available.begin()); }
+        state_.preferred.reset();
+        state_.error = "The selected display disconnected. Choose another display.";
+      }
+      return std::clamp(fallback, 0, static_cast<int>(available.size()) - 1);
+    }
+
+    /** @brief Publish the display opened by capture without overwriting a newer user choice.
+     * @param id Actual capture display identity.
+     */
+    void activate(const std::string &id) {
+      std::lock_guard lock {mutex_};
+      state_.active = id;
+    }
+    /** @brief Mark capture idle while preserving the next session's preferred display. */
+    void deactivate() {
+      std::lock_guard lock {mutex_};
+      state_.active.reset();
+    }
+    /** @return Whether running capture must reopen on a different requested display. */
+    bool needs_switch() const {
+      std::lock_guard lock {mutex_};
+      return state_.active && state_.preferred && state_.active != state_.preferred;
+    }
+    /** @return A consistent snapshot for authenticated management responses. */
+    DisplaySelectionSnapshot snapshot() const {
+      std::lock_guard lock {mutex_};
+      return state_;
+    }
+  private:
+    mutable std::mutex mutex_;  ///< Serializes management and capture changes.
+    DisplaySelectionSnapshot state_;  ///< Selection state owned by this engine process.
+  };
+
+  /** @return Engine-wide selection state, shared by the active capture pipeline. */
+  inline DisplaySelection &display_selection() {
+    static DisplaySelection selection;
+    return selection;
+  }
+}
