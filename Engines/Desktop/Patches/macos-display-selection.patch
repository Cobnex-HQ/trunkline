+  /**
+   * @brief Enumerate active macOS capture identities without starting capture or changing display settings.
+   * @return Active capture display IDs, labels and native pixel dimensions.
+   */
+  nlohmann::json trunkline_displays() {
+    auto result = nlohmann::json::array();
+#ifdef __APPLE__
+    CGDirectDisplayID ids[32] {};
+    uint32_t count = 0;
+    if (CGGetActiveDisplayList(32, ids, &count) != kCGErrorSuccess) {
+      return result;
+    }
+    const auto devices = display_device::enumerate_devices();
+    for (uint32_t i = 0; i < count; ++i) {
+      const auto id = std::to_string(ids[i]);
+      const auto found = std::find_if(devices.begin(), devices.end(), [&id](const auto &device) {
+        return device.m_display_name == id;
+      });
+      const auto name = found != devices.end() && !found->m_friendly_name.empty() ?
+                          found->m_friendly_name :
+                          (CGDisplayIsBuiltin(ids[i]) ? "Built-in display" : "Display " + std::to_string(i + 1));
+      auto mode = CGDisplayCopyDisplayMode(ids[i]);
+      if (!mode) {
+        continue;
+      }
+      result.push_back({{"id", id}, {"name", name},
+                        {"width", CGDisplayModeGetPixelWidth(mode)},
+                        {"height", CGDisplayModeGetPixelHeight(mode)}});
+      CGDisplayModeRelease(mode);
+    }
+#endif
+    return result;
+  }
+
+  /**
+   * @brief Describe pending intent separately from the display capture has actually opened.
+   * @param displays Fresh available display list.
+   * @return Management response; accepting a selection does not imply capture is ready.
+   */
+  nlohmann::json trunkline_display_status(nlohmann::json displays) {
+    const auto state = video::display_selection().snapshot();
+    nlohmann::json result {{"status", true}, {"displays", std::move(displays)},
+                           {"active_id", nullptr}, {"preferred_id", nullptr}, {"error", nullptr},
+                           {"switching", state.active && state.preferred && state.active != state.preferred}};
+#ifdef __APPLE__
+    result["supported"] = true;
+#else
+    result["supported"] = false;
+#endif
+    if (state.active) { result["active_id"] = *state.active; }
+    if (state.preferred) { result["preferred_id"] = *state.preferred; }
+    if (!state.error.empty()) { result["error"] = state.error; }
+    return result;
+  }
+
+  void getTrunklineDisplays(const resp_https_t &response, const req_https_t &request) {
+    if (!authenticate(response, request)) {
+      return;
+    }
+    send_response(response, trunkline_display_status(trunkline_displays()));
+  }
+
+  void selectTrunklineDisplay(const resp_https_t &response, const req_https_t &request) {
+    if (!authenticate(response, request) || !check_content_type(response, request, "application/json") ||
+        !validate_csrf_token(response, request, get_client_id(request))) {
+      return;
+    }
+    if (request->content.size() > 1024) {
+      bad_request(response, request, "Display selection request is too large");
+      return;
+    }
+    const auto input = nlohmann::json::parse(request->content.string(), nullptr, false);
+    if (!input.is_object() || !input.contains("id") || !input["id"].is_string()) {
+      bad_request(response, request, "A display identity is required");
+      return;
+    }
+    auto displays = trunkline_displays();
+    std::vector<std::string> ids;
+    for (const auto &display : displays) { ids.emplace_back(display.at("id").get<std::string>()); }
+    if (!video::display_selection().request(input["id"].get<std::string>(), ids)) {
+      bad_request(response, request, "The selected display is unavailable");
+      return;
+    }
+    send_response(response, trunkline_display_status(std::move(displays)));
+  }
+
