@@ -0,0 +1,76 @@
+/**
+ * @file tests/unit/platform/test_trunkline_geometry.mm
+ * @brief Verify capture geometry through production video and input conversion.
+ */
+#include "../../tests_common.h"
+#include "src/input.h"
+#include "src/video.h"
+#include "src/platform/virtualhid_input.h"
+#include "src/platform/macos/display_geometry.h"
+
+namespace video {
+  input::touch_port_t make_port(platf::display_t *, const config_t &);
+}
+namespace input {
+  std::optional<std::pair<float, float>> client_to_touchport(
+    std::shared_ptr<input_t> &, const std::pair<float, float> &, const std::pair<float, float> &);
+}
+namespace {
+  /** @brief Capture metadata fixture that never opens a capture device. */
+  struct GeometryDisplay: platf::display_t {
+    platf::capture_e capture(const push_captured_image_cb_t &, const pull_free_image_cb_t &, bool *) override {
+      return platf::capture_e::error;
+    }
+    std::shared_ptr<platf::img_t> alloc_img() override { return nullptr; }
+    int dummy_img(platf::img_t *) override { return 1; }
+  };
+}
+
+TEST(TrunklineDisplayGeometry, ConvertsCaptureMetadataThroughVideoAndInput) {
+  ASSERT_FALSE(task_pool.running());
+  auto platform_input = platf::input();
+  ASSERT_TRUE(platform_input);
+  auto &context = platf::virtualhid::get_input_context(platform_input);
+  context = platf::virtualhid::input_context_t {lvh::BackendKind::fake};
+  input::testing::set_platform_input(std::move(platform_input));
+  auto mailbox = std::make_shared<safe::mail_raw_t>();
+  auto client = input::alloc(mailbox, "trunkline-display-geometry");
+  const CGRect main = {{0, 0}, {1512, 982}};
+  const CGRect left = {{-1920, 0}, {1920, 1080}};
+  const CGRect above = {{0, -1200}, {1920, 1200}};
+  struct Case {
+    CGRect captured;
+    std::vector<CGRect> displays;
+    int pixels_w, pixels_h, stream_w, stream_h;
+    float expected_x, expected_y;
+  };
+  const std::vector<Case> cases {
+    {main, {main, left}, 3024, 1964, 1920, 1080, 2676, 491},
+    {main, {main, left}, 3024, 1964, 1080, 1920, 2676, 491},
+    {left, {main, left}, 1920, 1080, 1920, 1080, 960, 540},
+    {above, {main, above}, 3840, 2400, 1920, 1080, 960, 600},
+    {main, {main, above}, 3024, 1964, 1920, 1080, 756, 1691},
+  };
+  for (const auto &example : cases) {
+    GeometryDisplay display;
+    display.width = example.pixels_w;
+    display.height = example.pixels_h;
+    platf::apply_macos_input_geometry(display, example.captured, example.displays);
+    video::config_t config {};
+    config.width = example.stream_w;
+    config.height = example.stream_h;
+    const auto port = video::make_port(&display, config);
+    mailbox->event<input::touch_port_t>(mail::touch_port)->raise(port);
+    const auto result = input::client_to_touchport(client,
+      {example.stream_w / 2.0F, example.stream_h / 2.0F},
+      {static_cast<float>(example.stream_w), static_cast<float>(example.stream_h)});
+    ASSERT_TRUE(result.has_value());
+    EXPECT_NEAR(result->first, example.expected_x, 0.01F);
+    EXPECT_NEAR(result->second, example.expected_y, 0.01F);
+    EXPECT_EQ(port.env_logical_width, display.env_logical_width);
+    EXPECT_EQ(port.env_logical_height, display.env_logical_height);
+  }
+  client.reset();
+  input::terminate_gamepads();
+  input::testing::set_platform_input({});
+}
