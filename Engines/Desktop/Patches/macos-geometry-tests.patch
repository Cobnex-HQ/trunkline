 }
 #endif
+
+/** @brief Real HTTPS handlers reject unauthenticated reads and writes. */
+TEST_F(ConfigHttpTest, TrunklineDisplayAuthentication) {
+  SimpleWeb::CaseInsensitiveMultimap headers {{"Content-Type", "application/json"}};
+  EXPECT_EQ(client->request("GET", "/trunkline-displays-test")->status_code, "401 Unauthorized");
+  EXPECT_EQ(client->request("POST", "/trunkline-displays-test", R"({"id":"1"})", headers)->status_code, "401 Unauthorized");
+}
+
+/** @brief Cross-origin display changes retain the existing CSRF gate. */
+TEST_F(ConfigHttpTest, TrunklineDisplayCrossOriginRejection) {
+  SimpleWeb::CaseInsensitiveMultimap headers {
+    {"Authorization", create_auth_header("testuser", "testpass")},
+    {"Content-Type", "application/json"}, {"Origin", "https://example.invalid"}
+  };
+  EXPECT_EQ(client->request("POST", "/trunkline-displays-test", R"({"id":"1"})", headers)->status_code, "400 Bad Request");
+}
+
+/** @brief Validate JSON, types, bounds and unavailable identities at the HTTP boundary. */
+TEST_F(ConfigHttpTest, TrunklineDisplayRequestValidation) {
+  SimpleWeb::CaseInsensitiveMultimap headers {
+    {"Authorization", create_auth_header("testuser", "testpass")}, {"Content-Type", "application/json"}
+  };
+  for (const std::string &body : {std::string("not-json"), std::string("[]"), std::string("{}"),
+       std::string(R"({"id":4})"), std::string(R"({"id":""})"), std::string(R"({"id":"not-a-display"})"), std::string(1100, 'x')}) {
+    EXPECT_EQ(client->request("POST", "/trunkline-displays-test", body, headers)->status_code, "400 Bad Request");
+  }
+}
+
+/** @brief Listing is an authenticated snapshot even when no display is attached. */
+TEST_F(ConfigHttpTest, TrunklineDisplayListing) {
+  SimpleWeb::CaseInsensitiveMultimap headers {{"Authorization", create_auth_header("testuser", "testpass")}};
+  const auto response = client->request("GET", "/trunkline-displays-test", "", headers);
+  ASSERT_EQ(response->status_code, "200 OK");
+  const auto body = nlohmann::json::parse(response->content.string());
+  EXPECT_TRUE(body.at("status").get<bool>());
+  ASSERT_TRUE(body.at("displays").is_array());
+  EXPECT_TRUE(body.contains("active_id"));
+  EXPECT_TRUE(body.contains("preferred_id"));
+  EXPECT_TRUE(body.contains("error"));
+  EXPECT_TRUE(body.at("switching").is_boolean());
+#ifdef __APPLE__
+  EXPECT_TRUE(body.at("supported").get<bool>());
+#else
+  EXPECT_FALSE(body.at("supported").get<bool>());
+#endif
+  for (const auto &display : body.at("displays")) {
+    EXPECT_FALSE(display.at("id").get<std::string>().empty());
+    EXPECT_FALSE(display.at("name").get<std::string>().empty());
+    EXPECT_GT(display.at("width").get<int>(), 0);
+    EXPECT_GT(display.at("height").get<int>(), 0);
+  }
+}
+
+/** @brief Valid selection changes intent, not capture readiness; rejection retains that intent. */
+TEST_F(ConfigHttpTest, TrunklineDisplaySelection) {
+  SimpleWeb::CaseInsensitiveMultimap headers {
+    {"Authorization", create_auth_header("testuser", "testpass")}, {"Content-Type", "application/json"}
+  };
+  const auto response = client->request("GET", "/trunkline-displays-test", "", headers);
+  ASSERT_EQ(response->status_code, "200 OK");
+  const auto body = nlohmann::json::parse(response->content.string());
+  if (!body.at("supported").get<bool>() || body.at("displays").empty()) {
+    GTEST_SKIP() << "No active display in this graphical session";
+  }
+  const auto id = body.at("displays").front().at("id").get<std::string>();
+  const auto selected = client->request("POST", "/trunkline-displays-test", nlohmann::json({{"id", id}}).dump(), headers);
+  ASSERT_EQ(selected->status_code, "200 OK");
+  const auto selected_body = nlohmann::json::parse(selected->content.string());
+  EXPECT_TRUE(selected_body.at("status").get<bool>());
+  EXPECT_EQ(selected_body.at("preferred_id"), id);
+  EXPECT_TRUE(selected_body.at("active_id").is_null());
+  EXPECT_FALSE(selected_body.at("switching").get<bool>());
+  EXPECT_EQ(client->request("POST", "/trunkline-displays-test", R"({"id":"unavailable"})", headers)->status_code, "400 Bad Request");
+  const auto after = client->request("GET", "/trunkline-displays-test", "", headers);
+  EXPECT_EQ(nlohmann::json::parse(after->content.string()).at("preferred_id"), id);
+}
