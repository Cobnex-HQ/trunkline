+/**
+ * @file tests/unit/platform/test_trunkline_capture.mm
+ * @brief Exercise the actual capture loop with an inert AV source and synthetic display notifications.
+ */
+#include "../../tests_common.h"
+#import "src/platform/macos/av_video.h"
+#include "src/display_selection.h"
+
+namespace capture_fixture {
+  CGDisplayReconfigurationCallBack callback = nullptr;  ///< Registered geometry observer.
+  void *context = nullptr;  ///< Observer context.
+  unsigned starts = 0;  ///< Capture start count.
+  unsigned cancellations = 0;  ///< Explicit cancellation count.
+  bool select_display = false;  ///< Request a new display instead of removing one.
+  bool fail_start = false;  ///< Simulate output setup failure.
+  CGError register_callback(CGDisplayReconfigurationCallBack value, void *owner) {
+    callback = value; context = owner; return kCGErrorSuccess;
+  }
+  CGError remove_callback(CGDisplayReconfigurationCallBack, void *) {
+    callback = nullptr; context = nullptr; return kCGErrorSuccess;
+  }
+}
+
+/** @brief AV source that supplies no frames and never opens a capture device. */
+@interface TrunklineInertVideo: AVVideo
+@end
+@implementation TrunklineInertVideo
+- (dispatch_semaphore_t)capture:(FrameCallbackBlock)frameCallback {
+  ++capture_fixture::starts;
+  if (capture_fixture::fail_start) { return nil; }
+  auto signal = dispatch_semaphore_create(0);
+  if (capture_fixture::select_display) {
+    video::display_selection().request("external", {"main", "external"});
+  } else {
+    capture_fixture::callback(2, kCGDisplayRemoveFlag, capture_fixture::context);
+  }
+  return signal;
+}
+- (void)cancelCapture:(dispatch_semaphore_t)signal {
+  ++capture_fixture::cancellations;
+  dispatch_semaphore_signal(signal);
+}
+@end
+
+#define DisplayChangeObserver TrunklineObservedGeometry
+#define CGDisplayRegisterReconfigurationCallback capture_fixture::register_callback
+#define CGDisplayRemoveReconfigurationCallback capture_fixture::remove_callback
+#define AVVideo TrunklineInertVideo
+#define av_display_t TrunklineCaptureFixture
+#define display trunkline_display_fixture
+#define display_names trunkline_display_names_fixture
+#define needs_encoder_reenumeration trunkline_encoder_reenumeration_fixture
+#include "src/platform/macos/display.mm"
+#undef needs_encoder_reenumeration
+#undef display_names
+#undef display
+#undef av_display_t
+#undef AVVideo
+#undef CGDisplayRemoveReconfigurationCallback
+#undef CGDisplayRegisterReconfigurationCallback
+#undef DisplayChangeObserver
+
+TEST(TrunklineCaptureRecovery, DisplayRemovalWithoutFramesCancelsAndRequestsReinitialization) {
+  capture_fixture::starts = 0;
+  capture_fixture::cancellations = 0;
+  capture_fixture::fail_start = false;
+  {
+    platf::TrunklineCaptureFixture capture;
+    capture.topology = std::make_unique<platf::TrunklineObservedGeometry>();
+    capture.av_capture = [TrunklineInertVideo new];
+    bool cursor = true;
+    const auto begin = std::chrono::steady_clock::now();
+    const auto result = capture.capture([](auto &&, bool) { return true; }, [](auto &) { return false; }, &cursor);
+    EXPECT_EQ(result, platf::capture_e::reinit);
+    EXPECT_EQ(capture_fixture::cancellations, 1);
+    EXPECT_LT(std::chrono::steady_clock::now() - begin, std::chrono::seconds(2));
+    EXPECT_EQ(capture.capture([](auto &&, bool) { return true; }, [](auto &) { return false; }, &cursor), platf::capture_e::reinit);
+    EXPECT_EQ(capture_fixture::starts, 1);
+  }
+  EXPECT_EQ(capture_fixture::callback, nullptr);
+}
+
+TEST(TrunklineCaptureRecovery, CaptureSetupFailureReturnsErrorWithoutWaiting) {
+  capture_fixture::fail_start = true;
+  platf::TrunklineCaptureFixture capture;
+  capture.topology = std::make_unique<platf::TrunklineObservedGeometry>();
+  capture.av_capture = [TrunklineInertVideo new];
+  bool cursor = true;
+  EXPECT_EQ(capture.capture([](auto &&, bool) { return true; }, [](auto &) { return false; }, &cursor), platf::capture_e::error);
+  capture_fixture::fail_start = false;
+}
+
+/** @brief A pending monitor choice cancels idle capture without waiting for another frame. */
+TEST(TrunklineCaptureRecovery, DisplaySelectionWithoutFramesRequestsReinitialization) {
+  capture_fixture::starts = 0;
+  capture_fixture::cancellations = 0;
+  capture_fixture::fail_start = false;
+  capture_fixture::select_display = true;
+  auto cleanup = util::fail_guard([]() {
+    capture_fixture::select_display = false;
+    video::display_selection().deactivate();
+  });
+  video::display_selection().request("main", {"main", "external"});
+  video::display_selection().activate("main");
+  platf::TrunklineCaptureFixture capture;
+  capture.topology = std::make_unique<platf::TrunklineObservedGeometry>();
+  capture.av_capture = [TrunklineInertVideo new];
+  bool cursor = true;
+  const auto begin = std::chrono::steady_clock::now();
+  EXPECT_EQ(capture.capture([](auto &&, bool) { return true; }, [](auto &) { return false; }, &cursor), platf::capture_e::reinit);
+  EXPECT_EQ(capture_fixture::cancellations, 1);
+  EXPECT_LT(std::chrono::steady_clock::now() - begin, std::chrono::seconds(2));
+  EXPECT_EQ(video::display_selection().snapshot().preferred, "external");
+}
