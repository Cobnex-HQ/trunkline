+  void getTrunklineQuality(const resp_https_t &response, const req_https_t &request) {
+    if (!authenticate(response, request)) return;
+    send_response(response, trunkline_quality_status());
+  }
+  void setTrunklineQuality(const resp_https_t &response, const req_https_t &request) {
+    if (!authenticate(response, request) || !check_content_type(response, request, "application/json") ||
+        !validate_csrf_token(response, request, get_client_id(request))) return;
+    if (request->content.size() > 1024) { bad_request(response, request, "Quality request is too large"); return; }
+    const auto input = nlohmann::json::parse(request->content.string(), nullptr, false);
+    if (!input.is_object() || !input.contains("session") || !input["session"].is_number_unsigned() ||
+        !input.contains("kbps") || !input["kbps"].is_number_integer() ||
+        input["kbps"] < 1000 || input["kbps"] > 100000 ||
+        !video::adaptive_quality().request(input["session"].get<uint64_t>(), input["kbps"].get<int>())) {
+      bad_request(response, request, "The encoder session changed or the bitrate is unavailable"); return;
+    }
+    send_response(response, trunkline_quality_status());
+  }
