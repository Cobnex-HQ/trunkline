diff --git a/src/adaptive_quality.h b/src/adaptive_quality.h
new file mode 100644
--- /dev/null
+++ b/src/adaptive_quality.h
@@ -0,0 +1,49 @@
+/** Trunkline bounded bitrate control. Requests never change desktop geometry. */
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <mutex>
+namespace video {
+class AdaptiveQuality {
+public:
+  struct State {
+    uint64_t session = 0;
+    int maximum = 0, requested = 0, applied = 0;
+    bool failed = false;
+  };
+  uint64_t begin(int maximum) {
+    std::lock_guard lock(mutex_);
+    if (state_.session) { state_.failed = true; state_.requested = state_.maximum; return 0; }
+    state_ = {++generation_, maximum, maximum, 0, false};
+    return state_.session;
+  }
+  void end(uint64_t session) {
+    std::lock_guard lock(mutex_);
+    if (session && state_.session == session) state_ = {};
+  }
+  State snapshot() { std::lock_guard lock(mutex_); return state_; }
+  bool request(uint64_t session, int kbps) {
+    std::lock_guard lock(mutex_);
+    if (!session || session != state_.session || state_.failed || kbps < 1000 || kbps > state_.maximum) return false;
+    state_.requested = kbps;
+    return true;
+  }
+  int target(uint64_t session) {
+    std::lock_guard lock(mutex_);
+    return session && state_.session == session ? state_.requested : 0;
+  }
+  void applied(uint64_t session, int kbps) {
+    std::lock_guard lock(mutex_);
+    if (session && state_.session == session) state_.applied = kbps;
+  }
+  void failed(uint64_t session) {
+    std::lock_guard lock(mutex_);
+    if (session && state_.session == session) { state_.failed = true; state_.requested = state_.maximum; }
+  }
+private:
+  std::mutex mutex_;
+  uint64_t generation_ = 0;
+  State state_;
+};
+inline AdaptiveQuality &adaptive_quality() { static AdaptiveQuality value; return value; }
+}
