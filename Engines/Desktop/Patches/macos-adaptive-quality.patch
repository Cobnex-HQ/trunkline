+  nlohmann::json trunkline_quality_status() {
+    const auto state = video::adaptive_quality().snapshot();
+    return {{"session", state.session}, {"maximum", state.maximum}, {"requested", state.requested},
+            {"applied", state.applied}, {"failed", state.failed}};
