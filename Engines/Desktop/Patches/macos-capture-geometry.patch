+- (void)cancelCapture:(dispatch_semaphore_t)signal {
+  AVCaptureConnection *connection = nil;
+  AVCaptureVideoDataOutput *output = nil;
+  dispatch_queue_t queue = nil;
+  @synchronized(self) {
+    for (AVCaptureConnection *candidate in self.captureSignals) {
+      if ([self.captureSignals objectForKey:candidate] == signal) {
+        if (![self.captureCallbacks objectForKey:candidate]) { return; }
+        connection = [candidate retain];
+        output = [[self.videoOutputs objectForKey:candidate] retain];
+        queue = [self.captureQueues objectForKey:candidate];
+        dispatch_retain(queue);
+        // Prevent queued callbacks from acquiring another reference to caller state.
+        [self.captureCallbacks removeObjectForKey:candidate];
+        break;
+      }
+    }
+  }
+  if (!connection) { return; }
+  [output setSampleBufferDelegate:nil queue:nil];
+  // No session lock is held while the in-flight callback finishes.
+  dispatch_sync(queue, ^{});
+  @synchronized(self) {
+    [self.session removeOutput:output];
+    [self.videoOutputs removeObjectForKey:connection];
+    [self.captureSignals removeObjectForKey:connection];
+    [self.captureQueues removeObjectForKey:connection];
+  }
+  dispatch_semaphore_signal(signal);
+  dispatch_release(queue);
+  [output release];
+  [connection release];
+}
