diff --git a/src/platform/macos/display_change_observer.h b/src/platform/macos/display_change_observer.h
new file mode 100644
index 00000000..8d75012c
--- /dev/null
+++ b/src/platform/macos/display_change_observer.h
@@ -0,0 +1,40 @@
+/**
+ * @file src/platform/macos/display_change_observer.h
+ * @brief Invalidate a capture instance when logical display geometry changes.
+ */
+#pragma once
+#include <CoreGraphics/CoreGraphics.h>
+#include <atomic>
+
+namespace platf {
+  /** @brief Own one CoreGraphics observer for a capture instance's geometry. */
+  class DisplayChangeObserver {
+  public:
+    /** @brief Register for completed display configuration changes. */
+    DisplayChangeObserver(): registered_ {CGDisplayRegisterReconfigurationCallback(changed, this) == kCGErrorSuccess} {}
+    /** @brief Remove the callback before its state is destroyed. */
+    ~DisplayChangeObserver() {
+      if (registered_) { CGDisplayRemoveReconfigurationCallback(changed, this); }
+    }
+    DisplayChangeObserver(const DisplayChangeObserver &) = delete;
+    DisplayChangeObserver &operator=(const DisplayChangeObserver &) = delete;
+    /** @return Whether CoreGraphics accepted this observer. */
+    bool registered() const { return registered_; }
+    /** @return Whether geometry changed since this capture instance was created. */
+    bool invalidated() const { return invalidated_.load(); }
+  private:
+    /**
+     * @brief Mark geometry stale after a completed change; never call AVFoundation here.
+     * @param display Changed display, unused because all monitors affect the desktop origin.
+     * @param flags CoreGraphics display-change flags.
+     * @param context Owning observer.
+     */
+    static void changed([[maybe_unused]] CGDirectDisplayID display, CGDisplayChangeSummaryFlags flags, void *context) {
+      if (!(flags & kCGDisplayBeginConfigurationFlag)) {
+        static_cast<DisplayChangeObserver *>(context)->invalidated_.store(true);
+      }
+    }
+    bool registered_;  ///< Whether removal is required.
+    std::atomic<bool> invalidated_ {false};  ///< Read by capture and its delegate queue.
+  };
+}
