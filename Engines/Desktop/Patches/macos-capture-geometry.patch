new file mode 100644
index 00000000..4f292938
--- /dev/null
+++ b/src/platform/macos/display_geometry.h
@@ -0,0 +1,36 @@
+/**
+ * @file src/platform/macos/display_geometry.h
+ * @brief Capture geometry in the logical desktop coordinate space used by CoreGraphics input.
+ */
+#pragma once
+#include <CoreGraphics/CoreGraphics.h>
+#include <cmath>
+#include <vector>
+
+namespace platf {
+  /**
+   * @brief Populate input metadata for a captured monitor within the active desktop.
+   * @param display Capture descriptor with native pixel width and height already populated.
+   * @param captured Logical CoreGraphics bounds of the captured monitor.
+   * @param screens Logical bounds of all active monitors; empty enumeration uses the captured monitor.
+   * @details Offset fields are logical here because client_to_touchport adds them after dividing
+   * native capture coordinates by scalar_tpcoords. Environment pixel dimensions use the captured
+   * monitor's scale; the explicit logical environment dimensions are authoritative for mouse input.
+   */
+  template<class Display>
+  void apply_macos_input_geometry(Display &display, CGRect captured, const std::vector<CGRect> &screens) {
+    if (captured.size.width < 1 || captured.size.height < 1) { return; }
+    auto desktop = captured;
+    for (const auto &screen : screens) {
+      if (screen.size.width >= 1 && screen.size.height >= 1) { desktop = CGRectUnion(desktop, screen); }
+    }
+    display.offset_x = static_cast<int>(std::lround(captured.origin.x - desktop.origin.x));
+    display.offset_y = static_cast<int>(std::lround(captured.origin.y - desktop.origin.y));
+    display.logical_width = static_cast<int>(std::lround(captured.size.width));
+    display.logical_height = static_cast<int>(std::lround(captured.size.height));
+    display.env_logical_width = static_cast<int>(std::lround(desktop.size.width));
+    display.env_logical_height = static_cast<int>(std::lround(desktop.size.height));
+    display.env_width = static_cast<int>(std::lround(desktop.size.width * display.width / captured.size.width));
+    display.env_height = static_cast<int>(std::lround(desktop.size.height * display.height / captured.size.height));
+  }
+}
