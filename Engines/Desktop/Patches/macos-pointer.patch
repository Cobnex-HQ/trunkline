+      /**
+       * @brief Refresh logical display geometry outside the pointer event path.
+       */
+      void refresh_display_layout() {
+        auto value = std::make_shared<DisplayLayout>();
+        std::array<CGDirectDisplayID, 32> ids {};
+        uint32_t count = 0;
+        if (CGGetActiveDisplayList(ids.size(), ids.data(), &count) == kCGErrorSuccess) {
+          for (uint32_t i = 0; i < count; ++i) {
+            const auto rect = CGDisplayBounds(ids[i]);
+            if (rect.size.width >= 1 && rect.size.height >= 1) { value->screens.push_back(rect); }
+          }
+        }
+        if (value->screens.empty()) {
+          auto fallback = CGDisplayBounds(CGMainDisplayID());
+          if (fallback.size.width < 1 || fallback.size.height < 1) { fallback = CGRectMake(0, 0, 1, 1); }
+          value->screens.push_back(fallback);
+        }
+        value->bounds = value->screens.front();
+        for (const auto &rect : value->screens) { value->bounds = CGRectUnion(value->bounds, rect); }
+        std::lock_guard lock {layout_mutex};
+        layout = std::move(value);
+      }
+
