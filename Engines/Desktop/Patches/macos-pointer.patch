+    /**
+     * @brief Immutable logical-coordinate topology shared by mouse events.
+     */
+    struct DisplayLayout {
+      CGRect bounds {};  ///< Bounding rectangle of all active displays.
+      std::vector<CGRect> screens;  ///< Individual active display rectangles.
+
+      /**
+       * @brief Clamp a point to the nearest actual display, excluding desktop gaps.
+       * @param point Desired global CoreGraphics coordinate.
+       * @return Closest usable coordinate on an active display.
+       */
+      CGPoint clamp(CGPoint point) const {
+        CGPoint nearest = bounds.origin;
+        double distance = std::numeric_limits<double>::infinity();
+        for (const auto &screen : screens) {
+          const CGPoint candidate {
+            std::clamp(point.x, screen.origin.x, screen.origin.x + screen.size.width - 1),
+            std::clamp(point.y, screen.origin.y, screen.origin.y + screen.size.height - 1)
+          };
+          const auto dx = point.x - candidate.x;
+          const auto dy = point.y - candidate.y;
+          const auto squared = dx * dx + dy * dy;
+          if (squared < distance) { nearest = candidate; distance = squared; }
+        }
+        return nearest;
+      }
+    };
